# Production Environment Configuration Template for MIMAH ERP
# Copy this file to .env.production and fill in the actual values

# ERPNext Version
ERPNEXT_VERSION=v15.94.3

# Database Configuration
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
DB_HOST=mariadb
DB_PORT=3306

# Redis Configuration
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379

# SSL/TLS Configuration
LETSENCRYPT_EMAIL=admin@sohob.co.uk

# Site Configuration
FRAPPE_SITE_NAME_HEADER=mimah.sohob.co.uk
SITES=`mimah.sohob.co.uk`

# Nginx Configuration
HTTP_PUBLISH_PORT=8080
PROXY_READ_TIMEOUT=300
CLIENT_MAX_BODY_SIZE=100m

# Upstream Real IP Configuration (Coolify proxy)
UPSTREAM_REAL_IP_ADDRESS=172.17.0.0/16
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=on

# Docker Image Configuration
CUSTOM_IMAGE=frappe/erpnext
CUSTOM_TAG=v15.94.3
PULL_POLICY=always
RESTART_POLICY=unless-stopped

# Company Information
COMPANY_NAME=MIMAH
COMPANY_DOMAIN=mimah.sohob.co.uk
